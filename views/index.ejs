<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>insta</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Insta Blogs</h1>
    <br>
    <a class="createblog" href="http://localhost:8080/blogs/new">Create New Blog</a>
    <br>
    <br>
    <% for(blog of blogs) {%>
        <div class="blogs">
            <h2 class="id"><%= blog.id %></h2>
            <h2 class="user">User :<%= blog.username %></h2>
            <h2 class="content">Content : <br><%= blog.content %></h2>
            <br>
            <a href="http://localhost:8080/blogs/<%=blog.id%>/edit">Edit</a>
            <a href="http://localhost:8080/blogs/<%=blog.id%>">Details</a>
            <form action="http://localhost:8080/blogs/<%=blog.id%>?_method=DELETE" method="post">
                <br>
                <button>Delete</button>
            </form>
        </div>
    <% } %>
</body>
</html>