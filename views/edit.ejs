<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit blog</title>
</head>
<body>
    <H2>HERE IS YOUR bLOG</H2>
    <P>BLOG user <%= blog.id %></P>
    <P>BLOG user <%= blog.username %></P>
    <form action="/blogs/<%=blog.id%>?_method=PATCH" method="post">
        <textarea name="content" rows="10" cols="30"></textarea>
        <button>Submit</button>
    </form> 
</body>
</html>